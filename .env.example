# ---- Database (default backend) ---------------------------------------------------
# "postgres" = PostgreSQL + pgvector (docker compose up -d). "files" = old FAISS/BM25/JSONL fallback.
RETRIEVAL_BACKEND=postgres
# The app connects as rag_app (limited by row-level security):
DATABASE_URL=postgresql://rag_app:rag_app_dev@localhost:5432/rag
# Ingestion (scripts/build_db.py) connects as the table owner:
OWNER_DATABASE_URL=postgresql://rag_owner:rag_owner_dev@localhost:5432/rag
# Optional: change the host port if 5432 is already used (then update both URLs above)
# DB_PORT=5433

# Hosted LLM is optional. Without it, the project uses deterministic judge/generation fallbacks.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Retrieval models (EMBEDDING_DIM must match vector(384) in db/init/01_schema.sql)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
ENABLE_RERANKER=false

# Retrieval / trust tuning
DENSE_CANDIDATES=30
BM25_CANDIDATES=30
TOP_K=6
MIN_RELEVANCE_SCORE=0.24
RESTRICTED_THRESHOLD=0.42
DISCLOSE_RESTRICTED_EXISTENCE=true
